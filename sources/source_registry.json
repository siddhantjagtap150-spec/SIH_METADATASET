{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BIS Knowledge Base Source Registry",
  "description": "Registry defining authoritative sources permitted for constructing and verifying the BIS knowledge base.",
  "version": "1.0.0",

  "source_policy": {
    "primary_authority": "Bureau of Indian Standards",
    "country": "India",

    "source_priority": [
      {
        "priority": 1,
        "source_class": "bis_official",
        "description": "Official Bureau of Indian Standards websites, pages, portals and databases."
      },
      {
        "priority": 2,
        "source_class": "government_of_india",
        "description": "Official Government of India sources relevant to BIS regulation and mandatory requirements."
      },
      {
        "priority": 3,
        "source_class": "official_gazette",
        "description": "Official Gazette notifications and legally published regulatory documents."
      },
      {
        "priority": 4,
        "source_class": "government_ministry",
        "description": "Official ministries/departments issuing BIS-related orders, QCOs, notifications or regulatory directions."
      }
    ],

    "secondary_sources_allowed": false,
    "fabricated_information_allowed": false,
    "unsupported_claims_allowed": false,
    "unverified_records_allowed": false,

    "every_record_requires_source": true,
    "every_regulatory_record_requires_official_source": true,
    "every_fee_requires_source": true,
    "every_date_requires_source": true,
    "every_contact_requires_source": true,
    "every_relationship_requires_source": true,

    "source_url_required": true,
    "last_verified_required": true,

    "historical_sources_allowed": true,
    "superseded_sources_should_be_preserved": true
  },

  "source_classes": [

    {
      "source_class_id": "bis_official",
      "name": "BIS Official",
      "authority_level": "highest",
      "allowed": true,
      "examples": [
        "BIS official website",
        "BIS official portals",
        "BIS official databases",
        "BIS official downloadable documents"
      ]
    },

    {
      "source_class_id": "government_of_india",
      "name": "Government of India",
      "authority_level": "highest",
      "allowed": true,
      "examples": [
        "Government of India departments",
        "official government portals",
        "official government publications"
      ]
    },

    {
      "source_class_id": "official_gazette",
      "name": "Official Gazette",
      "authority_level": "highest",
      "allowed": true,
      "examples": [
        "Gazette notifications",
        "statutory notifications",
        "official regulatory publications"
      ]
    },

    {
      "source_class_id": "government_ministry",
      "name": "Government Ministry or Department",
      "authority_level": "highest",
      "allowed": true,
      "examples": [
        "Ministry-issued QCOs",
        "Ministry notifications",
        "Ministry orders",
        "Departmental directions"
      ]
    },

    {
      "source_class_id": "international_standard_body",
      "name": "International Standards Body",
      "authority_level": "contextual",
      "allowed": true,
      "examples": [
        "ISO",
        "IEC"
      ],
      "usage_rule": "Use only when the information is directly relevant to a BIS-adopted or referenced international standard. BIS or Government sources remain authoritative for BIS implementation."
    },

    {
      "source_class_id": "secondary",
      "name": "Secondary Source",
      "authority_level": "low",
      "allowed": false,
      "examples": [
        "Kaggle",
        "blogs",
        "commercial websites",
        "consultancy websites",
        "news articles",
        "Wikipedia",
        "unverified social media",
        "third-party summaries"
      ]
    }
  ],

