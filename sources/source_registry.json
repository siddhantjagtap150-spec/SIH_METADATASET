    "draft_standard",
    "amendment",
    "notification",
    "circular",
    "order",
    "guideline",
    "manual",
    "user_manual",
    "application_form",
    "checklist",
    "undertaking",
    "declaration",
    "certificate",
    "licence_document",
    "gazette",
    "act",
    "rule",
    "regulation",
    "qco",
    "test_method",
    "laboratory_document",
    "training_document",
    "faq",
    "other"
  ],

  "verification_status": [
    "verified",
    "pending_verification",
    "superseded",
    "withdrawn",
    "expired",
    "invalid",
    "rejected"
  ],

  "temporal_rules": {
    "track_effective_date": true,
    "track_expiry_date": true,
    "track_supersession": true,
    "track_withdrawal": true,
    "track_last_verified": true,

    "rule": "When multiple official sources exist, the knowledge base should prefer the source that is legally or operationally current while retaining historical sources for temporal reasoning."
  },

  "data_quality_rules": {
    "do_not_guess": true,
    "do_not_infer_legal_requirements_without_evidence": true,
    "do_not_invent_fees": true,
    "do_not_invent_timelines": true,
    "do_not_invent_contact_details": true,
    "do_not_invent_standard_numbers": true,
    "do_not_invent_qco_numbers": true,
    "do_not_invent_product_coverage": true,
    "do_not_invent_scheme_applicability": true,
    "do_not_invent_laboratory_capabilities": true,

    "unknown_value_policy": {
      "allowed_values": [
        null,
        "unknown",
        "not_available_in_source"
      ],
      "rule": "Unknown information must remain explicitly unknown instead of being guessed."
    }
  },

