      "relationship_id": "Unique identifier for the relationship type.",
      "source_entity_type": "Entity type from the BIS taxonomy.",
      "relationship_type": "Semantic relationship between source and target.",
      "target_entity_type": "Entity type from the BIS taxonomy.",
      "direction": "Whether the relationship is directional or bidirectional.",
      "description": "Meaning of the relationship.",
      "inverse_relationship": "Logical inverse relationship where applicable.",
      "evidence_required": true
    }
  },

